# Copy to .env and fill in. Everything is optional.

# Port for the web server
PORT=3000

# Sarvam is the tutor's brain AND voice when this is set: it writes the replies,
# turns the child's speech into text, and speaks the replies in Hindi.
SARVAM_API_KEY=
# Optional overrides (defaults shown)
# SARVAM_MODEL=sarvam-105b-conversations
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=ishita

# Used only when SARVAM_API_KEY is empty: Claude writes the replies and the browser
# does the voice. With neither key, the built-in rule-based tutor runs.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
